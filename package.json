{
  "name": "@effortlessmotion/pdf-to-md",
  "version": "0.1.6",
  "description": "Extract PDFs to structured markdown: text layer via pdf.js, OCR fallback for image-only pages, pure npm and cross-platform",
  "keywords": [
    "pdf",
    "markdown",
    "ocr",
    "tesseract",
    "extract",
    "convert"
  ],
  "homepage": "https://github.com/kmalakoff/pdf-to-md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kmalakoff/pdf-to-md.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "bin": {
    "pdf-to-md": "bin/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "cr": "^0.1.0",
    "node-version-use": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "ts-dev-stack": "^1.22.3",
    "tsds-config": "^1.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "tesseract.js": true,
    "core-js-pure": true,
    "@swc/core": true,
    "node-filename-to-dist-paths": true,
    "node-semvers": true,
    "node-version-use": true,
    "thread-sleep-compat": true
  }
}
